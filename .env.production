# URL del backend para los builds de producción (npm run build, que es lo que
# ejecuta Vercel). npm run dev no lee este archivo: en local se usa .env.local o,
# sin él, http://localhost:3001. Una variable VITE_API_URL definida en el
# dashboard de Vercel tiene prioridad sobre este valor.
VITE_API_URL=https://micrositio-backend-2-express.vercel.app
